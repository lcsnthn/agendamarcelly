$("view").onclick=function(e){
  var t=e.target.closest("button,a");if(!t)return;
  if(t.dataset.nav){st.month=new Date(st.month.getFullYear(),st.month.getMonth()+ +t.dataset.nav,1);render()}
  else if(t.dataset.srv!==undefined){st.srv=+t.dataset.srv;render()}
  else if(t.dataset.date){st.date=t.dataset.date;st.time=null;render()}
  else if(t.dataset.time){st.time=t.dataset.time;render()}
  else if(t.dataset.go){var n=$("i-nome");st.step=+t.dataset.go;render()}
  else if(t.dataset.mode){st.mode=t.dataset.mode;st.err="";render()}
};
/* ===== Cadastro e pontos (salvos neste aparelho) ===== */
function contas(){try{return JSON.parse(localStorage.getItem("clientes:v1")||"{}")}catch(e){return{}}}
function dig(t){return t.replace(/\D/g,"")}
function conta(){return contas()[dig(st.tel)]||{ags:[]}}
function pts(){return st.pts||0}
function reg(){var c=contas(),d=dig(st.tel),o=c[d]||{nome:st.nome,tel:st.tel};o.ags=o.ags||[];
  if(!o.ags.some(function(a){return a.date===st.date&&a.time===st.time}))o.ags.push({id:Date.now().toString(36),srv:CFG.servicos[st.srv].n,date:st.date,time:st.time});
  c[d]=o;try{localStorage.setItem("clientes:v1",JSON.stringify(c))}catch(e){}}
$("view").addEventListener("click",function(e){
  var t=e.target.closest("button,a");if(!t)return;
  if(t.id==="sair"){try{localStorage.removeItem("cliente:v1")}catch(x){}st.nome="";st.tel="";st.srv=null;st.date=null;st.time=null;st.err="";st.step=1;render()}
  else if(t.id==="cad"){
    var nome=$("i-nome").value.trim(),tel=$("i-tel").value.trim(),d=dig(tel),err="";
    st.nome=nome;st.tel=tel;
    if(nome.length<2)err="Informe seu nome.";else if(d.length<10)err="Informe um WhatsApp válido com DDD.";
    if(err){st.err=err;return render()}
    if(isAdm(nome,tel)){try{localStorage.setItem("cliente:v1",JSON.stringify({nome:nome,tel:tel}))}catch(x){}st.admin=true;st.err="";ad.day=iso(new Date());return render()}
    var c=contas(),o=c[d]||{};o.nome=nome;o.tel=tel;o.ags=o.ags||[];c[d]=o;
    try{localStorage.setItem("clientes:v1",JSON.stringify(c));localStorage.setItem("cliente:v1",JSON.stringify({nome:nome,tel:tel}))}catch(x){}
    st.err="";st.step=2;render();loadPts()}
  else if(t.id==="novo"){st.srv=null;st.date=null;st.time=null;st.obs="";st.step=2;render()}
  else if(t.id==="book"){book()}
});

function confetti(){var c=["#d48286","#f2c6c8","#fff","#e0b24a","#3cc98a"];
  for(var i=0;i<40;i++){var e=document.createElement("i");e.className="cf";e.style.left=Math.random()*100+"vw";e.style.background=c[i%c.length];e.style.animationDuration=(2+Math.random()*1.8)+"s";e.style.animationDelay=(Math.random()*.6)+"s";document.body.appendChild(e);setTimeout(function(x){x.remove()},4500,e)}}
function countUp(){var b=document.querySelector(".pt b");if(!b)return;var to=+b.textContent,i=0;if(!to)return;b.textContent=0;var iv=setInterval(function(){i++;b.textContent=i;if(i>=to)clearInterval(iv)},Math.min(90,700/to))}

/* ===== Banco de dados (Supabase) e administrador ===== */
var sb=null;try{if(String(CFG.supaUrl).indexOf("http")===0)sb=supabase.createClient(CFG.supaUrl,CFG.supaKey)}catch(e){}
var busy=[];
function isAdm(n,t){return n.toLowerCase().replace(/\s/g,"")==="MarcellyLima"&&dig(t)==="3186786570"}
async function loadBusy(){if(!sb)return;var n=new Date(),f=new Date(n.getFullYear(),n.getMonth(),n.getDate()+CFG.dias);
  var r=await sb.rpc("horarios_ocupados",{dia_ini:iso(n),dia_fim:iso(f)});
  if(r.data){var b=r.data.map(function(x){return x.data+" "+String(x.hora).slice(0,5)});if(JSON.stringify(b)!==JSON.stringify(busy)){busy=b;if(st.step===3&&!st.admin)render()}}}
async function loadPts(){if(!sb||!st.tel||st.admin)return;var r=await sb.rpc("meus_pontos",{tel:dig(st.tel)});
  if(typeof r.data==="number"&&r.data!==st.pts){st.pts=r.data;if(!st.admin&&(st.step===2||st.step===6))render()}}
async function book(){
  var be=$("berr");
  if(!sb){be.textContent="Site sem banco de dados. Preencha supaUrl e supaKey no arquivo.";return}
  var s=CFG.servicos[st.srv],b=$("book");b.disabled=true;b.textContent="Reservando...";
  var r=await sb.from("agendamentos").insert({servico:s.n,data:st.date,hora:st.time,nome:st.nome,telefone:dig(st.tel),obs:st.obs||null});
  if(r.error){b.disabled=false;b.textContent="Confirmar agendamento";
    if(r.error.code==="23505"){be.textContent="Esse horário acabou de ser reservado por outra pessoa. Volte e escolha outro.";st.time=null;loadBusy()}
    else be.textContent="Não foi possível reservar agora. Tente novamente.";
    return}
  reg();loadBusy();st.step=5;render();
}
var LAB={agendado:"agendado",concluido:"concluído",desmarcado:"desmarcado"},COR={agendado:"#e0b24a",concluido:"#3cc98a",desmarcado:"#d64545"},
 ad={items:[],day:iso(new Date()),month:new Date(new Date().getFullYear(),new Date().getMonth(),1),tab:"cal",f:"prox",user:null,err:"",init:false,ready:false,sub:null};
if(isAdm(st.nome,st.tel))st.admin=true;
if(!st.admin&&st.tel)loadPts();
function mp(x){return{id:x.id,srv:x.servico,date:x.data,time:String(x.hora).slice(0,5),nome:x.nome,tel:x.telefone,obs:x.obs||"",status:x.status,at:x.criado_em}}
async function adLoad(){var r=await sb.from("agendamentos").select("*").order("data").order("hora");
  if(r.data){var l=r.data.map(mp);if(JSON.stringify(l)!==JSON.stringify(ad.items)){ad.items=l;if(st.admin)renderAdmin()}}}
function adSub(){if(ad.sub)return;ad.sub=sb.channel("ag").on("postgres_changes",{event:"*",schema:"public",table:"agendamentos"},adLoad).subscribe();setInterval(function(){if(st.admin&&ad.user)adLoad()},30000)}
async function adInit(){
  if(sb){var r=await sb.auth.getSession();ad.user=(r.data&&r.data.session)?r.data.session.user:null;if(ad.user){await adLoad();adSub()}}
  ad.ready=true;if(st.admin)renderAdmin()}
function wl(i){var n=dig(i.tel);if(n.length<=11)n="55"+n;var q=i.srv+" ("+fdata(i.date)+" às "+i.time+")",m;
  if(i.status==="desmarcado")m="Olá, "+i.nome+"! Precisei desmarcar seu horário de "+q+". Vamos remarcar?";
  else if(i.status==="concluido")m="Olá, "+i.nome+"! Obrigada pela visita, foi um prazer te atender! 💕";
  else m="Olá, "+i.nome+"! Seu horário de "+q+" está confirmado. Te esperamos!";
  return "https://wa.me/"+n+"?text="+encodeURIComponent(m)}
function acal(){
  var m=ad.month,y=m.getFullYear(),mo=m.getMonth(),hoje=iso(new Date());
  var h='<div class="cal"><div class="ch"><button data-a="mn" data-n="-1" aria-label="Mês anterior">‹</button><b>'+m.toLocaleDateString("pt-BR",{month:"long",year:"numeric"})+'</b><button data-a="mn" data-n="1" aria-label="Próximo mês">›</button></div><div class="g">';
  ["dom","seg","ter","qua","qui","sex","sáb"].forEach(function(w){h+='<small>'+w+'</small>'});
  for(var i=0;i<m.getDay();i++)h+='<span></span>';
  for(var d=1,dim=new Date(y,mo+1,0).getDate();d<=dim;d++){var k=iso(new Date(y,mo,d)),has=ad.items.some(function(i){return i.date===k&&i.status==="agendado"});
    h+='<button data-a="day" data-d="'+k+'" class="'+(ad.day===k?'sel ':'')+(has?'has ':'')+(k===hoje?'today':'')+'">'+d+'</button>'}
  return h+'</div></div>';
}
function card(i,sd){var nv=i.status==="agendado"&&Date.now()-new Date(i.at)<864e5;
  return '<div class="it"><div class="itr"><b>'+(sd?esc(fdata(i.date))+' · ':'')+i.time+' · '+esc(i.srv)+'</b><span class="bdg" style="color:'+COR[i.status]+'">'+(nv?'novo · ':'')+LAB[i.status]+'</span></div><div>'+esc(i.nome)+' · '+esc(i.tel)+'</div>'+(i.obs?'<div class="sub" style="margin:4px 0 0">Obs: '+esc(i.obs)+'</div>':'')+
  (i.status==="agendado"?'<button class="mini" data-a="done" data-i="'+i.id+'">Concluir</button><button class="mini" data-a="canc" data-i="'+i.id+'">Desmarcar</button>':'<button class="mini" data-a="open" data-i="'+i.id+'">Reabrir</button>')+
  '<a class="mini" data-a="wa" target="_blank" rel="noopener" href="'+wl(i)+'">Avisar cliente</a><button class="mini" data-a="del" data-i="'+i.id+'">Excluir</button></div>'}
function renderAdmin(){
  $("steps").innerHTML="";$("view").className="";var v=$("view");
  if(!sb){v.innerHTML='<h1>Configuração pendente</h1><p class="sub">Preencha supaUrl e supaKey no início do arquivo.</p>';return}
  if(!ad.ready){v.innerHTML='<p class="sub">Carregando...</p>';return}
  if(!ad.user){v.innerHTML='<h1>Acesso do administrador</h1><p class="sub">Entre com o e-mail e a senha que você criou no Supabase.</p><label>E-mail</label><input id="a-em" type="email" autocomplete="username"><label>Senha</label><input id="a-pw" type="password" autocomplete="current-password"><div class="err">'+esc(ad.err)+'</div><div class="row"><button class="btn ghost" data-a="sair">Voltar ao site</button><button class="btn" data-a="login">Entrar</button></div>';return}
  var n=new Date(),hoje=iso(n),agora=hoje+pad(n.getHours())+":"+pad(n.getMinutes());
  var at=ad.items.filter(function(i){return i.status==="agendado"}),hj=at.filter(function(i){return i.date===hoje}).length;
  var px=at.filter(function(i){return i.date+i.time>=agora}).sort(function(a,b){return a.date+a.time<b.date+b.time?-1:1})[0];
  var h='<h1>Olá, Lucas</h1><div class="av"><b>'+hj+' atendimento(s) hoje</b><div class="sub" style="margin:2px 0 0">'+(px?'Próximo: '+esc(fdata(px.date))+' às '+px.time+' · '+esc(px.nome):'Nenhum atendimento agendado à frente.')+'</div></div>'+
  '<div class="tabs"><button class="mini'+(ad.tab==="cal"?' on':'')+'" data-a="tab" data-t="cal">Calendário</button><button class="mini'+(ad.tab==="lista"?' on':'')+'" data-a="tab" data-t="lista">Atendimentos</button></div>';
  if(ad.tab==="cal"){
    var dia=ad.items.filter(function(i){return i.date===ad.day}).sort(function(a,b){return a.time<b.time?-1:1});
    h+=acal()+'<div class="dh">'+esc(fdata(ad.day))+'</div>'+(dia.length?dia.map(function(i){return card(i,false)}).join(""):'<p class="sub">Nenhum atendimento neste dia.</p>');
  }else{
    var F={prox:"Próximos",pend:"A concluir",conc:"Concluídos",desm:"Desmarcados"},asc=ad.f==="prox"||ad.f==="pend";
    var l=ad.items.filter(function(i){return ad.f==="prox"?(i.status==="agendado"&&i.date>=hoje):ad.f==="pend"?(i.status==="agendado"&&i.date<hoje):ad.f==="conc"?i.status==="concluido":i.status==="desmarcado"})
      .sort(function(a,b){var x=a.date+a.time,y=b.date+b.time;return asc?(x<y?-1:1):(x<y?1:-1)});
    h+='<div class="tabs" style="flex-wrap:wrap">'+Object.keys(F).map(function(k){return '<button class="mini'+(ad.f===k?' on':'')+'" data-a="flt" data-t="'+k+'">'+F[k]+'</button>'}).join("")+'</div>'+(l.length?l.map(function(i){return card(i,true)}).join(""):'<p class="sub">Nenhum atendimento aqui.</p>');
  }
  h+='<p class="note">Novos agendamentos aparecem aqui automaticamente. Ao concluir, o cliente ganha 1 ponto.</p><div class="row"><button class="btn ghost" data-a="sair">Sair</button></div>';
  v.innerHTML=h;
}
$("view").addEventListener("click",async function(e){
  if(!st.admin)return;var t=e.target.closest("[data-a]");if(!t)return;var a=t.dataset.a,id=t.dataset.i;
  async function alt(v){var r=await sb.from("agendamentos").update({status:v}).eq("id",id);if(r.error)alert("Não foi possível alterar: "+r.error.message);await adLoad()}
  if(a==="sair"){try{localStorage.removeItem("cliente:v1")}catch(x){}try{if(sb)await sb.auth.signOut()}catch(x){}ad.user=null;ad.items=[];ad.init=false;st.admin=false;st.nome="";st.tel="";st.step=1;st.err="";render()}
  else if(a==="login"){var r=await sb.auth.signInWithPassword({email:$("a-em").value.trim(),password:$("a-pw").value});
    if(r.error){ad.err="E-mail ou senha incorretos."}else{ad.err="";ad.user=r.data.user;await adLoad();adSub()}renderAdmin()}
  else if(a==="mn"){ad.month=new Date(ad.month.getFullYear(),ad.month.getMonth()+ +t.dataset.n,1);renderAdmin()}
  else if(a==="day"){ad.day=t.dataset.d;renderAdmin()}
  else if(a==="tab"){ad.tab=t.dataset.t;renderAdmin()}
  else if(a==="flt"){ad.f=t.dataset.t;renderAdmin()}
  else if(a==="done")alt("concluido");
  else if(a==="canc")alt("desmarcado");
  else if(a==="open")alt("agendado");
  else if(a==="del"){if(confirm("Excluir este atendimento?")){var r2=await sb.from("agendamentos").delete().eq("id",id);if(r2.error)alert("Não foi possível excluir.");await adLoad()}}
});

render();
</script>
</body>
</html>
