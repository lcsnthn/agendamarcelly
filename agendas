.st{animation:none}.st.on{animation:pop .5s both}
@keyframes pop{0%{transform:scale(0) rotate(-40deg)}70%{transform:scale(1.25)}100%{transform:scale(1)}}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
#view.anim>*{animation:up .5s cubic-bezier(.2,.7,.2,1) both}
#view.anim>*:nth-child(2){animation-delay:.05s}#view.anim>*:nth-child(3){animation-delay:.1s}#view.anim>*:nth-child(4){animation-delay:.15s}#view.anim>*:nth-child(5){animation-delay:.2s}#view.anim>*:nth-child(n+6){animation-delay:.25s}
.cf{position:fixed;top:-14px;width:8px;height:13px;z-index:9;pointer-events:none;animation:fall linear forwards}
