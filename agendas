    if(st.date){var hs=horas(st.date);h+='<p class="slh">Horários · '+esc(fdata(st.date))+'</p>'+(hs.length?'<div class="slots">'+hs.map(function(x){return '<button class="s'+(st.time===x?' sel':'')+'" data-time="'+x+'">'+x+'</button>'}).join("")+'</div>':'<p class="sub">Sem horários livres neste dia.</p>')}
