.row{display:flex;gap:10px;margin-top:24px}
.btn{flex:1;display:block;text-align:center;text-decoration:none;border:1px solid var(--btn);background:var(--btn);color:var(--btx);padding:14px;font:inherit;text-transform:uppercase;letter-spacing:.12em;font-weight:700;cursor:pointer}
