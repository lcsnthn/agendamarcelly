    '<p class="note">Ao confirmar, seu horário é reservado na hora e '+esc(CFG.nome)+' recebe o aviso.</p>';
  }
  var vw=$("view"),ch=st.step!==window._ls;vw.className=ch?"anim":"";window._ls=st.step;vw.innerHTML=h;if(ch&&st.step===5)confetti();if(ch&&st.step===6)countUp();if(ch&&st.step===3)loadBusy();if(ch&&(st.step===2||st.step===6))loadPts();
