function $(i){return document.getElementById(i)}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function pad(n){return String(n).padStart(2,"0")}
function iso(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())}
function parse(s){var p=s.split("-");return new Date(+p[0],+p[1]-1,+p[2])}
function fdata(s){return parse(s).toLocaleDateString("pt-BR",{weekday:"long",day:"numeric",month:"long"})}
function fprof(){var n=CFG.whats.replace(/^55/,"");return "("+n.slice(0,2)+") "+n.slice(2,n.length-4)+"-"+n.slice(-4)}
function horas(ds){var out=[],now=new Date(),d=parse(ds),mine=(conta().ags||[]);
  for(var m=CFG.abre*60;m<CFG.fecha*60;m+=CFG.passo){var dt=new Date(d.getFullYear(),d.getMonth(),d.getDate(),Math.floor(m/60),m%60),hh=pad(Math.floor(m/60))+":"+pad(m%60);
    if(dt>now&&busy.indexOf(ds+" "+hh)<0&&CFG.ocupados.indexOf(ds+" "+hh)<0)out.push(hh)}
  return out}
function ok(d){var n=new Date(),t=new Date(n.getFullYear(),n.getMonth(),n.getDate()),max=new Date(t.getFullYear(),t.getMonth(),t.getDate()+CFG.dias);return d>=t&&d<=max&&CFG.fechado.indexOf(d.getDay())<0&&horas(iso(d)).length>0}
function primeiro(){var n=new Date();for(var i=0;i<=CFG.dias;i++){var d=new Date(n.getFullYear(),n.getMonth(),n.getDate()+i);if(ok(d))return d}return null}
function cal(){
  var m=st.month,y=m.getFullYear(),mo=m.getMonth(),n=new Date(),cur=new Date(n.getFullYear(),n.getMonth(),1);
  var last=new Date(n.getFullYear(),n.getMonth(),n.getDate()+CFG.dias);
