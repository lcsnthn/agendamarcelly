.g{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.g small{color:var(--mut);font-size:.68rem;text-transform:uppercase;padding:4px 0}
.g button,.g span{aspect-ratio:1;display:flex;align-items:center;justify-content:center}
.g button{border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;border-radius:50%}
