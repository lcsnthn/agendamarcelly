.slh{font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;margin:0 0 10px}
.slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:8px}
.s{border:1px solid var(--bd);background:transparent;color:inherit;font:inherit;padding:10px 0;cursor:pointer}
.s.sel{background:var(--ac);border-color:var(--ac);color:#fff}
label{display:block;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:var(--mut);margin:14px 0 4px}
