.g button{transition:transform .15s,background .15s}.g button:hover:not([disabled]){transform:scale(1.12)}
.g button.sel{background:var(--ac);color:#fff;transform:scale(1.1);box-shadow:0 4px 14px rgba(212,130,134,.5)}
.s{border-radius:12px;transition:all .15s}.s:hover{border-color:var(--ac);transform:translateY(-2px)}
