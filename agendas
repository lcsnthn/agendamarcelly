    '<div class="err">'+esc(st.err)+'</div><div class="row"><button class="btn" id="cad">Continuar</button></div>';
  }else if(st.step===2){
    h='<div class="itr" style="align-items:center;margin-bottom:12px"><span></span><button class="mini" style="margin:0" data-go="6">⭐ '+pts()+' ponto(s)</button></div><h1>Escolha o serviço</h1><p class="sub">Olá, '+esc(st.nome)+'! Selecione o que você quer agendar.</p>'+
    CFG.servicos.map(function(s,i){return '<button class="card'+(st.srv===i?' sel':'')+'" data-srv="'+i+'"><div class="ic">'+(s.e||"✨")+'</div><div class="tx"><b>'+esc(s.n)+'</b><span>'+esc(s.d)+'</span></div><div class="pr">'+esc(s.p)+'</div></button>'}).join("")+
    '<div class="row"><button class="btn ghost" id="sair">Sair</button><button class="btn" data-go="3"'+(st.srv===null?' disabled':'')+'>Continuar</button></div>';
  }else if(st.step===3){
    if(!st.date){var p=primeiro();if(p){st.date=iso(p);st.month=new Date(p.getFullYear(),p.getMonth(),1)}}
